<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/widget_board"
        android:orientation="vertical"
        android:padding="11dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/flap_a1"
                style="@style/WidgetFlap"
                android:text="H"
                android:layout_width="20dp"
                android:layout_marginHorizontal="1dp"
                android:background="@drawable/widget_flap" />
            <TextView
                android:id="@+id/flap_a2"
                style="@style/WidgetFlap"
                android:text="E"
                android:layout_width="20dp"
                android:layout_marginHorizontal="1dp"
                android:background="@drawable/widget_flap" />
            <TextView
                android:id="@+id/flap_a3"
                style="@style/WidgetFlap"
                android:text="R"
                android:layout_width="20dp"
                android:layout_marginHorizontal="1dp"
                android:background="@drawable/widget_flap" />
            <TextView
                android:id="@+id/flap_a4"
                style="@style/WidgetFlap"
                android:text="E"
                android:layout_width="20dp"
                android:layout_marginHorizontal="1dp"
                android:background="@drawable/widget_flap" />
            <TextClock
                android:id="@+id/flap_a_h"
                style="@style/WidgetFlap"
                android:layout_width="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_flap_pair"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:letterSpacing="0.622" />
            <TextView
                style="@style/WidgetFlap"
                android:layout_width="8dp"
                android:text=":" />

            <TextClock
                android:id="@+id/flap_a_m"
                style="@style/WidgetFlap"
                android:layout_width="44dp"
                android:background="@drawable/widget_flap_pair"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:letterSpacing="0.622" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/flap_b1"
                style="@style/WidgetFlap"
                android:text="+8"
                android:textSize="11dp"
                android:layout_width="20dp"
                android:layout_marginHorizontal="1dp"
                android:background="@drawable/widget_flap" />
            <TextView
                android:id="@+id/flap_b2"
                style="@style/WidgetFlap"
                android:text="T"
                android:layout_width="20dp"
                android:layout_marginHorizontal="1dp"
                android:background="@drawable/widget_flap" />
            <TextView
                android:id="@+id/flap_b3"
                style="@style/WidgetFlap"
                android:text="Y"
                android:layout_width="20dp"
                android:layout_marginHorizontal="1dp"
                android:background="@drawable/widget_flap" />
            <TextView
                android:id="@+id/flap_b4"
                style="@style/WidgetFlap"
                android:text="O"
                android:layout_width="20dp"
                android:layout_marginHorizontal="1dp"
                android:background="@drawable/widget_flap" />
            <TextClock
                android:id="@+id/flap_b_h"
                style="@style/WidgetFlap"
                android:layout_width="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_flap_pair"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:letterSpacing="0.622" />
            <TextView
                style="@style/WidgetFlap"
                android:layout_width="8dp"
                android:text=":" />

            <TextClock
                android:id="@+id/flap_b_m"
                style="@style/WidgetFlap"
                android:layout_width="44dp"
                android:background="@drawable/widget_flap_pair"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:letterSpacing="0.622" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
